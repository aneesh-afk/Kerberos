# Kerberos SSO Project - Example Environment Configuration
# Copy this file to .env and provide 32-byte Base64-encoded keys

AS_TGS_SHARED_KEY="replace_with_base64_32_byte_key"
TGS_SERVICE_SHARED_KEY="replace_with_base64_32_byte_key"
KERBEROS_CLOCK_SKEW_SECONDS=300
TGT_LIFETIME_SECONDS=3600
SERVICE_TICKET_LIFETIME_SECONDS=600
SERVICE_ID="service-server"
